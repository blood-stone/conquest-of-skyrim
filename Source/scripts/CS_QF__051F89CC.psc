;BEGIN FRAGMENT Fragment_20
Function Fragment_20()
;BEGIN CODE
UnRegisterForUpdateGameTime()
int ref = 0
while ref < DefenderRefs.Length
	DefenderRefs[ref].GetActorRef().delete()
	ref += 1
endwhile
int i = 0
while i < AllLocations.GetSize()
	Location FortLoc = AllLocations.GetAt(i) as Location
	if FortLoc == Alias_Fort.GetLocation()
		if (GarrisonsFortImp.GetAt(i) as GlobalVariable).GetValue() > 0
			(GarrisonsFortImp.GetAt(i) as GlobalVariable).SetValue((GarrisonsFortImp.GetAt(i) as GlobalVariable).GetValue() - TroopDeath.GetValue())
		elseif (GarrisonsFortSons.GetAt(i) as GlobalVariable).GetValue() > 0
			(GarrisonsFortSons.GetAt(i) as GlobalVariable).SetValue((GarrisonsFortSons.GetAt(i) as GlobalVariable).GetValue() - TroopDeath.GetValue())
		endif 
		(TriggerBoxes.GetAt(i) as ObjectReference).enable()
	endif
	i += 1
endwhile

stop()
;END CODE
EndFunction
