;BEGIN FRAGMENT Fragment_15
Function Fragment_15()
;BEGIN CODE
int i = 0
while i < AllLocations.GetSize()
	If Alias_Fort.GetLocation() == (AllLocations.GetAt(i) as Location)
		ObjectReference SpawnPoint = SpawnPoints[i].GetAt(utility.randomint(0, SpawnPoints[i].GetSize() - 1)) as ObjectReference
		If TroopDeath.GetValue() < DefenderCount.GetValue() - 20
			int index = 0
			while index < DefenderRefs.Length
				If (AllHoldings.GetAt(i) as GlobalVariable).GetValue() == 11
					ActorBase SoldierBase = SiegeTroopSoldier
					Actor Soldier = SpawnPoint.PlaceAtMe(SoldierBase) as Actor
					if DefenderRefs[index].GetActorRef().IsDead() == 1
						DefenderRefs[index].ForceRefTo(Soldier)
					endif
				ElseIf (AllHoldings.GetAt(i) as GlobalVariable).GetValue() == 12
					ActorBase SoldierBase = SiegeTroopSoldierSons
					Actor Soldier = SpawnPoint.PlaceAtMe(SoldierBase) as Actor
					if DefenderRefs[index].GetActorRef().IsDead() == 1
						DefenderRefs[index].ForceRefTo(Soldier)
					endif
				EndIf
				index += 1
			endwhile
		endIf
	endIf
	i += 1
endwhile
;END CODE
EndFunction
;END FRAGMENT

;BEGIN FRAGMENT Fragment_22
Function Fragment_22()
;BEGIN CODE
int i = 0
while i < AllLocations.GetSize()
	Location FortLoc = AllLocations.GetAt(i) as Location
	GlobalVariable CatapultsUsed = CatapultsUsedList.GetAt(i) as GlobalVariable
	if FortLoc == Alias_Fort.GetLocation()
		ObjectReference TriggerBoxActivator = TriggerBoxes.GetAt(i) as ObjectReference
		ObjectReference PlayerMarker = PlayerMarkers.GetAt(i) as ObjectReference
		GlobalVariable FortHolding = AllHoldings.GetAt(i) as GlobalVariable
		ObjectReference EnemyGarrisonMarkerImp = EnemyGarrisonMarkersImp.GetAt(i) as ObjectReference
		ObjectReference EnemyGarrisonMarkerSons = EnemyGarrisonMarkersSons.GetAt(i) as ObjectReference
		(GarrisonsImp.GetAt(i) as GlobalVariable).SetValue(0.5*(GarrisonsImp.GetAt(i) as GlobalVariable).GetValue())
		(GarrisonsSons.GetAt(i) as GlobalVariable).SetValue(0.5*(GarrisonsSons.GetAt(i) as GlobalVariable).GetValue())
		(GarrisonsFortImp.GetAt(i) as GlobalVariable).SetValue(0)
		(GarrisonsFortSons.GetAt(i) as GlobalVariable).SetValue(0)
		TriggerBoxActivator.disable()
		PlayerMarker.enable()
		int index = 0
		while index < CityGuards[i].GetSize()
			Actor Guard = CityGuards[i].GetAt(index) as Actor
			OutfitChanger.ForceRefTo(Guard)
			OutfitChanger.GetActorRef().SetOutfit(OutfitsGuard.GetAt(OutfitNum.GetValue() as int) as Outfit)
			OutfitChanger.GetActorRef().RemoveItem(OutfitChanger.GetActorRef().GetEquippedWeapon())
			OutfitChanger.GetActorRef().RemoveItem(OutfitChanger.GetActorRef().GetEquippedShield())
			OutfitChanger.GetActorRef().EquipItem(BowsGuard.GetAt(OutfitNum.GetValue() as int) as Weapon)
			OutfitChanger.GetActorRef().AddItem(AmmoGuard.GetAt(OutfitNum.GetValue() as int) as Ammo, 100)
			OutfitChanger.GetActorRef().EquipItem(AmmoGuard.GetAt(OutfitNum.GetValue() as int) as Ammo)
			OutfitChanger.GetActorRef().EquipItem(SwordsGuard.GetAt(OutfitNum.GetValue() as int) as Weapon)
			OutfitChanger.GetActorRef().EquipItem(ShieldsGuard.GetAt(OutfitNum.GetValue() as int) as Armor)
			OutfitChanger.Clear()
			index += 1
		endwhile
		FortHolding.SetValue(1)
		FortLoc.SetKeywordData(CWOwner, 69)
		EnemyGarrisonMarkerImp.disable()
		EnemyGarrisonMarkerSons.disable()
		int factionnum = 0
		while factionnum < OwnershipFactions[i].GetSize()
			Faction OwnershipFaction = OwnershipFactions[i].GetAt(factionnum) as Faction
			Game.GetPlayer().AddToFaction(OwnershipFaction)
			factionnum += 1
		endwhile
		PlayerCityCount.SetValue(PlayerCityCount.GetValue() + 1)
		(GovQuest as CS_ChangeBanners).ReplaceFortBanners(i)
	endif
	i += 1
endwhile

stop()
;END CODE
EndFunction
;END FRAGMENT

;BEGIN FRAGMENT Fragment_6
Function Fragment_6()
;BEGIN CODE
RegisterForUpdateGameTime(0.5)
TroopDeath.SetValue(0)
PercentRemaining.SetValue(100)
PercentRemainingTrue.SetValue(100)
UpdateCurrentInstanceGlobal(PercentRemaining)
UpdateCurrentInstanceGlobal(PercentRemainingTrue)
int i = 0
while i < AllLocations.GetSize()
	Location FortLoc = AllLocations.GetAt(i) as Location
	if FortLoc == Alias_Fort.GetLocation()
		(TriggerBoxes.GetAt(i) as ObjectReference).disable()
		if (GarrisonsFortImp.GetAt(i) as GlobalVariable).GetValue() > 0
			DefenderCount.SetValue((GarrisonsFortImp.GetAt(i) as GlobalVariable).GetValue()) 
		elseif (GarrisonsFortSons.GetAt(i) as GlobalVariable).GetValue() > 0
			DefenderCount.SetValue((GarrisonsFortSons.GetAt(i) as GlobalVariable).GetValue()) 
		endif 
		SetObjectiveDisplayed(0, true, true)
		int index = 0
		while index < 20 && index < DefenderCount.GetValue()
			ObjectReference SpawnPoint = SpawnPoints[i].GetAt(utility.randomint(0, SpawnPoints[i].GetSize() - 1)) as ObjectReference
				If (AllHoldings.GetAt(i) as GlobalVariable).GetValue() == 11
					Actor Soldier = SpawnPoint.PlaceAtMe(SiegeTroopSoldier) as Actor
					DefenderRefs[index].ForceRefTo(Soldier)
				ElseIf (AllHoldings.GetAt(i) as GlobalVariable).GetValue() == 12
					Actor Soldier = SpawnPoint.PlaceAtMe(SiegeTroopSoldierSons) as Actor
					DefenderRefs[index].ForceRefTo(Soldier)
				EndIf
			index += 1
		endwhile
	endif
	i += 1
endwhile

UpdateCurrentInstanceGlobal(DefenderCount)
UpdateCurrentInstanceGlobal(TroopDeath)

SetStage(2)

endFunction

Event OnUpdateGameTime()
	if Game.GetPlayer().IsInLocation(Alias_Fort.GetLocation()) == 0
		SetStage(21)
	endif
endEvent

