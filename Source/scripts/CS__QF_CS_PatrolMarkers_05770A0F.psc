			PMArray = PMOnes
		elseif (PMs[i].GetRef() as CS_WarStartAmbushScript).PatrolKeyword == PatrolKeyword2
			PMArray = PMTwos
		elseif (PMs[i].GetRef() as CS_WarStartAmbushScript).PatrolKeyword == PatrolKeyword3
			PMArray = PMThrees
