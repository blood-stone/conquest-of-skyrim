Function Fragment_23()
;BEGIN CODE
int i = 0
while i < AllLocations.GetSize()
	Location CityLoc = AllLocations.GetAt(i) as Location
	GlobalVariable CatapultsUsed = CatapultsUsedList.GetAt(i) as GlobalVariable
	if CityLoc == Alias_City.GetLocation()
		ObjectReference TriggerBoxActivator = TriggerBoxes.GetAt(i) as ObjectReference
		Faction EnemyFaction = EnemyFactions.GetAt(i) as Faction 
		ObjectReference PlayerMarker = PlayerMarkers.GetAt(i) as ObjectReference
		GlobalVariable TaxTime = TaxTimes.GetAt(i) as GlobalVariable
		GlobalVariable CityHolding = AllHoldings.GetAt(i) as GlobalVariable
		ObjectReference EnemyGarrisonMarkerImp = EnemyGarrisonMarkersImp.GetAt(i) as ObjectReference
		ObjectReference EnemyGarrisonMarkerSons = EnemyGarrisonMarkersSons.GetAt(i) as ObjectReference
		CatapultsUsed.SetValue(0)
		CatapultQuest.SetStage(20)
		if Alias_EnemyJarl.GetActorRef() == LeaderImp.GetActorRef() || Alias_EnemyJarl.GetActorRef() == LeaderSons.GetActorRef()
			JarlCitizens[i].ForceRefTo(Alias_JarlTrue.GetActorRef())
			JarlSurrenderer.ForceRefTo(Alias_JarlTrue.GetActorRef())
			JarlCitizens[i].GetOwningQuest().SetStage(10)
		else
			JarlCitizens[i].ForceRefTo(Alias_EnemyJarl.GetActorRef())
			JarlSurrenderer.ForceRefTo(Alias_EnemyJarl.GetActorRef())
			JarlCitizens[i].GetOwningQuest().SetStage(10)
		endif
		TriggerBoxActivator.disable()
		PlayerMarker.enable()
		CityLoc.SetKeywordData(CWOwner, 69)
		int index = 0
		while index < CityGuards[i].GetSize()
			Actor Guard = CityGuards[i].GetAt(index) as Actor
			(UpgradeTroopQuest as CS_UpgradeTroopsMenu).UpgradeGuard(Guard)
			index += 1
		endwhile
		TaxTime.SetValue(GameDaysPassed.GetValue())
		CityHolding.SetValue(1)
		int factionnum = 0
		while factionnum < OwnershipFactions[i].GetSize()
			Faction OwnershipFaction = OwnershipFactions[i].GetAt(factionnum) as Faction
			Game.GetPlayer().AddToFaction(OwnershipFaction)
			factionnum += 1
		endwhile
		int mapmarkernum = 0
		while mapmarkernum < 3
			ObjectReference MapMarker = MapMarkersArray[i].GetAt(mapmarkernum) as ObjectReference
			MapMarker.enable()
			mapmarkernum += 1
		endwhile
		int guardmarkernum = 0
		while guardmarkernum < GarrisonMarkersImp[i].GetSize()
			ObjectReference GarrisonMarkerImp = GarrisonMarkersImp[i].GetAt(guardmarkernum) as ObjectReference
			GarrisonMarkerImp.disable()
			guardmarkernum += 1
		endwhile
		guardmarkernum = 0
		while guardmarkernum < GarrisonMarkersSons[i].GetSize()
			ObjectReference GarrisonMarkerSons = GarrisonMarkersSons[i].GetAt(guardmarkernum) as ObjectReference
			GarrisonMarkerSons.disable()
			guardmarkernum += 1
		endwhile
		PlayerCityCount.SetValue(PlayerCityCount.GetValue() + 1)
		if GovQuest.GetStage() == 15
			if PlayerCityCount.GetValue() == 4 && PlayerMajorCityCount.GetValue() == 5
				GovQuest.SetStage(16)
			endif
		endif
		If Alias_EnemyJarl.GetActorRef().IsInFaction(GovImperial) == 1 || Alias_JarlTrue.GetActorRef().IsInFaction(GovImperial) == 1
			CityCountImp.SetValue(CityCountImp.GetValue() - 1)
			AttackedCityImp.ForceLocationTo(CityLoc)
			WarQuestImp.SetStage(15)
		ElseIf Alias_EnemyJarl.GetActorRef().IsInFaction(GovSons) == 1 || Alias_JarlTrue.GetActorRef().IsInFaction(GovSons) == 1
			CityCountSons.SetValue(CityCountSons.GetValue() - 1)
			AttackedCitySons.ForceLocationTo(CityLoc)
			WarQuestSons.SetObjectiveCompleted(i)
			WarQuestSons.SetStage(15)
		EndIf
		if (PlayerCityCount.GetValue() == 1) && (PlayerMajorCityCount.GetValue() == 0)
			NewCapitalMessage.Show()
			(GovQuest as CS_GovScriptFunctions).SetUpCapital(i)
		endif
		(GovQuest as CS_ChangeBanners).ReplaceCityBanners(i)
		(EconUpdater as CS_EconomyVariableFunctions).UpdateEconomy()
	endif
	i += 1
endwhile

stop()
;END CODE
EndFunction
;END FRAGMENT

;BEGIN FRAGMENT Fragment_13
Function Fragment_13()
;BEGIN CODE
TroopDeath.SetValue(TroopDeath.GetValue() + 1)
float percentchange = 100*(1/(DefenderCount.GetValue())) as float
PercentRemainingTrue.SetValue(PercentRemainingTrue.GetValue() - percentchange)
percentchange = (PercentRemaining.GetValue() - PercentRemainingTrue.GetValue()) as int

if TroopDeath.GetValue() == Math.Floor(0.75*DefenderCount.GetValue())
	SetStage(11)
endif

if TroopDeath.GetValue() == DefenderCount.GetValue()
	PercentRemaining.SetValue(0)
	percentchange = 0
	UpdateCurrentInstanceGlobal(PercentRemaining)
	SetObjectiveCompleted(0)
endif

if percentchange >= 10 && PercentRemainingTrue.GetValue() > 0
	ModObjectiveGlobal(-percentchange, PercentRemaining, 0)
endif
;END CODE
EndFunction
