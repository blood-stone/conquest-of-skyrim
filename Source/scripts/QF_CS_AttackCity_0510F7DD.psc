Function Fragment_19()
;BEGIN CODE
int i = 0
while i < AllLocations.GetSize()
	If Alias_City.GetLocation() == (AllLocations.GetAt(i) as Location)
		ObjectReference SpawnPoint = SpawnPoints[i].GetAt(utility.randomint(0, SpawnPoints[i].GetSize() - 1)) as ObjectReference
		ObjectReference SpawnPoint2 = SpawnPoints2[i].GetAt(utility.randomint(0, SpawnPoints2[i].GetSize() - 1)) as ObjectReference
		If TroopDeath.GetValue() < DefenderCount.GetValue() - 10
			If TroopDeath.GetValue() < Math.Floor(0.75*DefenderCount.GetValue()) - 15
				int index = 0
				while index < DefenderRefs.Length
					If (AllHoldings.GetAt(i) as GlobalVariable).GetValue() == 11
						if DefenderRefs[index].GetActorRef().IsDead() == 1
							ActorBase SoldierBase = SiegeTroopSoldier
							Actor Soldier = SpawnPoint.PlaceAtMe(SoldierBase) as Actor
							DefenderRefs[index].ForceRefTo(Soldier)
						endif
					ElseIf (AllHoldings.GetAt(i) as GlobalVariable).GetValue() == 12
						if DefenderRefs[index].GetActorRef().IsDead() == 1
							ActorBase SoldierBase = SiegeTroopSoldierSons
							Actor Soldier = SpawnPoint.PlaceAtMe(SoldierBase) as Actor
							DefenderRefs[index].ForceRefTo(Soldier)
						endif
					EndIf
					index += 1
				endwhile
			Else
				Alias_DefenseMarker.ForceRefTo(Alias_DefenseMarker2.GetReference())
				int index = 0
				while index < DefenderRefs.Length
					If (AllHoldings.GetAt(i) as GlobalVariable).GetValue() == 11
						if DefenderRefs[index].GetActorRef().IsDead() == 1
							ActorBase SoldierBase = SiegeTroopSoldier
							Actor Soldier = SpawnPoint2.PlaceAtMe(SoldierBase) as Actor
							DefenderRefs[index].ForceRefTo(Soldier)
						endif
					ElseIf (AllHoldings.GetAt(i) as GlobalVariable).GetValue() == 12
						if DefenderRefs[index].GetActorRef().IsDead() == 1
							ActorBase SoldierBase = SiegeTroopSoldierSons
							Actor Soldier = SpawnPoint2.PlaceAtMe(SoldierBase) as Actor
							DefenderRefs[index].ForceRefTo(Soldier)
						endif
					EndIf
					index += 1
				endwhile
			EndIf
		endIf
	endIf
	i += 1
endwhile
