State HoldMap
    
    Event OnCellAttach()
        debug.trace("holdmap still on top, not resetting...")
    EndEvent
    
EndState

EVENT OnCellAttach()

    ResetFlags()
    
endEVENT

function ResetFlags()
    RemoveFlags()
    if Is3DLoaded() && !HoldMap
    
        ((self as ObjectReference) as CS_CWMapActivatorHoldThread00).GoToState("ResetFlags")
        ((self as ObjectReference) as CS_CWMapActivatorHoldThread01).GoToState("ResetFlags")
        ((self as ObjectReference) as CS_CWMapActivatorHoldThread02).GoToState("ResetFlags")
        ((self as ObjectReference) as CS_CWMapActivatorHoldThread03).GoToState("ResetFlags")
        ((self as ObjectReference) as CS_CWMapActivatorHoldThread04).GoToState("ResetFlags")
        ((self as ObjectReference) as CS_CWMapActivatorHoldThread05).GoToState("ResetFlags")
        ((self as ObjectReference) as CS_CWMapActivatorHoldThread06).GoToState("ResetFlags")
        ((self as ObjectReference) as CS_CWMapActivatorHoldThread07).GoToState("ResetFlags")
        ((self as ObjectReference) as CS_CWMapActivatorHoldThread08).GoToState("ResetFlags")
        
        RegisterForSingleUpdate(0.1)
    endif
endFunction

function RemoveFlags()
    
    ((self as ObjectReference) as CS_CWMapActivatorHoldThread00).GoToState("RemoveFlags")
    ((self as ObjectReference) as CS_CWMapActivatorHoldThread01).GoToState("RemoveFlags")
    ((self as ObjectReference) as CS_CWMapActivatorHoldThread02).GoToState("RemoveFlags")
    ((self as ObjectReference) as CS_CWMapActivatorHoldThread03).GoToState("RemoveFlags")
    ((self as ObjectReference) as CS_CWMapActivatorHoldThread04).GoToState("RemoveFlags")
    ((self as ObjectReference) as CS_CWMapActivatorHoldThread05).GoToState("RemoveFlags")
    ((self as ObjectReference) as CS_CWMapActivatorHoldThread06).GoToState("RemoveFlags")
    ((self as ObjectReference) as CS_CWMapActivatorHoldThread07).GoToState("RemoveFlags")
    ((self as ObjectReference) as CS_CWMapActivatorHoldThread08).GoToState("RemoveFlags")
    
    RegisterForSingleUpdate(0.1)
    
EndFunction

Function ChooseMap(Activator NewMap)
    ChosenNewMap = NewMap
EndFunction

Function SwitchMaps(Activator NewMap, Sound BookSound)
    GoToState("HoldMap")
    ;RemoveHoldFlags()
    RemoveFlags()
    BookSound.Play(self)
    ChooseMap(NewMap)
    Utility.Wait(0.5)
    if ChosenNewMap == NewMap
        ObjectReference NewMapRef = PlaceAtMe(NewMap, abForcePersist = true, abInitiallyDisabled = true)
        HoldMap = NewMapRef
        NewMapRef.MoveTo(self, afXOffset=-Math.Sin(GetAngleY()) + Math.Sin(GetAngleZ()), afYOffset=Math.Sin(GetAngleX()) + Math.Cos(GetAngleZ()), afZOffset=Math.Cos(GetAngleX()) + Math.Cos(GetAngleY()))
        (NewMapRef as CS_CWMapActivatorHoldScript).OldMap = self
        NewMapRef.EnableNoWait()
        (NewMapRef as CS_CWMapActivatorHoldScript).ResetFlags()
        ;(NewMapRef as CS_CWMapActivatorHoldScript).TryToPlaceFlags()
        ChosenNewMap = None
        ;disable()
    endif
EndFunction
